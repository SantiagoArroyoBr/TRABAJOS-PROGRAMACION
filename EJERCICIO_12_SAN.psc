Algoritmo ejercicio_12
	a <- 1
	Escribir 'Seleccione el numero de la tabla que quiera ver: 'Sin Saltar
	Leer a
	Escribir 'Numero de veces a multiplicar'
	Leer c
	b <- 1
	Escribir 'Esta es la tabla del ', a, ' hasta el ', c
	Mientras b<=c Hacer
		Escribir b, '.-', a, ' x ', b, ' = 'Sin Saltar
		Escribir a*b
		b <- b+1
	FinMientras
FinAlgoritmo
